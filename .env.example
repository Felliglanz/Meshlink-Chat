# Wird von install.sh erzeugt. Manuell: kopieren nach .env und ausfüllen.
# Nach Änderungen: /opt/meshlink-chat/install.sh --update

# Adresse von MeshMonitor, von MeshLink Chat aus gesehen.
#  - MeshMonitor auf demselben Host/LXC:   http://127.0.0.1:3001  (bzw. dessen Port)
#  - sonst die LAN-Adresse, z. B.          http://192.168.1.20:8080
MM_URL=http://127.0.0.1:3001
# API-Token aus MeshMonitor (Benutzermenü -> API Token), Format mm_v1_...
MM_TOKEN=
# Optional: bestimmte Quelle (sourceId). Leer = primäre Quelle.
MM_SOURCE=
# Optional: eigene Node-ID, falls die automatische Erkennung nicht klappt (z. B. !a1b2c3d4 oder mc:<pubkey>)
MY_NODE_ID=

# Login-Passwort für die App (mind. 8 Zeichen, kein ')
APP_PASSWORD=
# Zufälliger Schlüssel für Sitzungs-Cookies und Push. Ändern = alle Geräte abgemeldet, Push neu einschalten.
SESSION_SECRET=
SESSION_DAYS=30

# Abfrage-Intervall in ms (App offen / keine App offen)
POLL_MS=3000
IDLE_POLL_MS=15000

# Adresse und Port, auf denen MeshLink Chat lauscht.
# 127.0.0.1 = nur lokal (HTTPS-Proxy/Tunnel auf demselben Host), 0.0.0.0 = im LAN erreichbar (Proxy/Tunnel auf anderem Host).
BIND_ADDR=0.0.0.0
HOST_PORT=8090
