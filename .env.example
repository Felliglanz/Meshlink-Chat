# Wird von install.sh erzeugt. Manuell: kopieren nach .env und ausfüllen.
# Created by install.sh. Manually: copy to .env and fill in.
# Nach Änderungen / after changes: /opt/meshlink-chat/install.sh --update

# Adresse von MeshMonitor, von MeshLink Chat aus gesehen / MeshMonitor address as seen from MeshLink Chat
#  - gleicher Host/LXC / same host or LXC:   http://127.0.0.1:3001
#  - sonst LAN-Adresse / otherwise LAN:      http://192.168.1.20:8080
MM_URL=http://127.0.0.1:3001
# API-Token aus MeshMonitor (Benutzermenü -> API Token) / API token from MeshMonitor (user menu -> API Token), mm_v1_...
MM_TOKEN=
# Optional: bestimmte Quelle (sourceId), leer = primäre / specific source (sourceId), empty = primary
MM_SOURCE=
# Optional: eigene Node-ID, falls die Erkennung nicht klappt / own node ID if detection fails (!a1b2c3d4 or mc:<pubkey>)
MY_NODE_ID=

# Login-Passwort für die App (mind. 8 Zeichen, kein ') / app login password (at least 8 characters, no ')
APP_PASSWORD=
# Zufälliger Schlüssel für Sitzungen und Push. Ändern = alle Geräte abgemeldet, Push neu einschalten.
# Random key for sessions and push. Changing it logs out all devices; turn push on again.
SESSION_SECRET=
SESSION_DAYS=30

# Repeater-Verwaltung (Admin-Login, Befehle, Neustart) über MeshMonitor: 1 = an. Wer die App öffnen kann, kann dann
# Repeater umstellen. Der Token braucht remote_admin lesen + schreiben.
# Repeater admin (admin login, commands, reboot) through MeshMonitor: 1 = on. Anyone who can open the app can then
# reconfigure repeaters. The token needs remote_admin read + write.
REMOTE_ADMIN=0

# Abfrage-Intervall in ms (App offen / keine App offen) / poll interval in ms (app open / no app open)
POLL_MS=3000
IDLE_POLL_MS=15000

# Adresse und Port, auf denen MeshLink Chat lauscht / address and port MeshLink Chat listens on
# 127.0.0.1 = nur lokal / local only (proxy on the same host), 0.0.0.0 = im LAN / in the LAN (proxy on another host)
BIND_ADDR=0.0.0.0
HOST_PORT=8090
